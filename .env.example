# --- Nursing Executive Administration System (Flask) ---
# Copy to .env and fill in real values. Never commit .env.

# Flask
FLASK_ENV=development
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Database
# Local dev (SQLite, zero setup):
DATABASE_URL=sqlite:///nursing.sqlite3
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nursing

# Brute-force protection (per-account lockout, on top of the per-IP rate limit)
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# Rate-limit storage. The default is per-process, so a multi-worker deployment
# MUST point this at a shared backend or the limit is multiplied by the worker
# count and resets on every deploy.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
